# Local development can use placeholder values. Localhost bypasses public write
# protection so the creation and report flows remain easy to test.
APP_ENV=development
TURNSTILE_SITE_KEY=replace-with-public-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key
RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
LEMON_SQUEEZY_CHECKOUT_ENABLED=false
LEMON_SQUEEZY_API_KEY=replace-with-lemon-squeezy-api-key
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-lemon-squeezy-webhook-secret
LEMON_SQUEEZY_STORE_ID=replace-with-lemon-squeezy-store-id
LEMON_SQUEEZY_VARIANT_5_ID=replace-with-usd-5-credit-variant-id
LEMON_SQUEEZY_VARIANT_10_ID=replace-with-usd-10-credit-variant-id
LEMON_SQUEEZY_VARIANT_20_ID=replace-with-usd-20-credit-variant-id
LEMON_SQUEEZY_SUPPORT_VARIANT_ID=replace-with-pay-what-you-want-support-variant-id
