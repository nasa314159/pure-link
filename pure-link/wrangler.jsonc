/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pure-link",
	"main": "src/index.js",
	"compatibility_date": "2026-01-28",
	"observability": {
		"enabled": true
	},
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAAEOveWALXghlMLNL",
		"PUBLIC_ORIGIN": "https://no-no.uk",
		"CREEM_PRODUCT_300_ID": "prod_4UdvN9knG2AzhhktS3Nwj9",
		// Non-credential payment configuration lives here as the single
		// documented source of truth (see docs/BILLING.*.md): these values are
		// intentionally NOT secrets so their effective state is inspectable and
		// survives every deploy. The exact strings are the fail-closed gate
		// values recognized in src/payments.js, src/ecpay.js, and
		// src/lemon-squeezy.js; anything else is treated as disabled.
		// ECPay merchant credentials (ECPAY_MERCHANT_ID, ECPAY_HASH_KEY,
		// ECPAY_HASH_IV) and the Donate rail flag (ECPAY_SUPPORT_CHECKOUT_ENABLED)
		// remain Worker secrets, managed out-of-band and never printed.
		"AI_CREDIT_PURCHASES_ENABLED": "true",
		"ECPAY_CHECKOUT_ENABLED": "true",
		"ECPAY_ENVIRONMENT": "production"
	},
	// Binary module import rules (imported in src/index.js) for the Formula OG
	// image feature (src/formula-og.js): the wordmark font is imported as Data
	// and resvg's compiled WASM uses wrangler's default CompiledWasm rule.
	"rules": [
		{
			"type": "Data",
			"globs": ["**/*.ttf"],
			"fallthrough": true
		}
	],
	// mathjax-full reads its own package version through a require() fallback
	// unless this is defined at bundle time; workerd would crash on that
	// eval'd require without the define.
	"define": {
		"PACKAGE_VERSION": "\"3.2.1\""
	},
	"routes": [
		{
			"pattern": "no-no.uk",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "pure_link_db",
			"database_name": "pure-link-production",
			"database_id": "4bfcfb5c-1ce7-4fcb-8686-5f32b8412f46"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"placement": {
		"mode": "smart"
	},
	"env": {
		"staging": {
			"name": "pure-link-staging",
			"ai": {
				"binding": "AI"
			},
			// Staging vars are NOT inherited from the top level: everything here
			// is the isolated staging environment's own source of truth (separate
			// D1, separate hostname staging.no-no.uk) and all checkout rails are
			// explicitly fail-closed so staging can never create real payments.
			"vars": {
				// Same non-credential Turnstile site key; the Managed widget is
				// authorized for both no-no.uk and staging.no-no.uk
				// (docs/RELEASE_CHECKLIST.md). Staging secrets stay separate.
				"TURNSTILE_SITE_KEY": "0x4AAAAAAEOveWALXghlMLNL",
				"PUBLIC_ORIGIN": "https://staging.no-no.uk",
				// Fail-closed payment gates: purchases and ECPay Donate are
				// disabled on staging, and ECPay points at its stage endpoint
				// instead of production (src/ecpay.js ecpayEndpoint()).
				"AI_CREDIT_PURCHASES_ENABLED": "false",
				"ECPAY_CHECKOUT_ENABLED": "false",
				"ECPAY_ENVIRONMENT": "stage"
			},
			// Define is not inherited from the top level either; workerd would
			// crash on mathjax-full's package-version require() fallback
			// without it (same requirement as production).
			"define": {
				"PACKAGE_VERSION": "\"3.2.1\""
			},
			"d1_databases": [
				{
					"binding": "pure_link_db",
					"database_name": "pure-link-staging-v2",
					"database_id": "49a8a6cc-49fe-4f2a-9a31-5e38b3576421"
				}
			],
			"routes": [
				{
					"pattern": "staging.no-no.uk",
					"custom_domain": true
				}
			]
		}
	}
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
