{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"types": []
	},
	"include": [
		"client/formula-editor.js",
		"client/content-actions.js",
		"src/i18n.js"
	]
}
